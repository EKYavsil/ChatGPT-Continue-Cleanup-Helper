{
  "manifest_version": 3,
  "name": "ChatGPT File Continue & Cleanup Helper",
  "description": "Downloads generated ChatGPT files, asks ChatGPT to continue, and can clean up non-project chats.",
  "version": "1.1.3",
  "permissions": ["downloads", "storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["file-api.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatGPT File Continue & Cleanup Helper",
    "default_popup": "popup.html"
  }
}
